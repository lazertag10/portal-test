<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="tMl{#3I%AHw}TQ_=`n%@">mySprite</variable><variable type="KIND_SpriteKind" id="TSib1SaLO2l8R]EKXL}J">Player</variable><variable type="KIND_SpriteKind" id="HAhbcS-f}BiYpUq;(ac6">Projectile</variable><variable type="KIND_SpriteKind" id="A)[G$(fn/.(EK?bA#.Ch">Food</variable><variable type="KIND_SpriteKind" id="(~22)kZsjwDCmO2otKw(">Enemy</variable></variables><block type="pxt-on-start" id="i+XCjy+,pDJ~fiaW6;$j" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="@o_WGdF0;=Im#RAxuu-p"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace portalPhysics {" line1="" line2="    // ============================================================" line3="    // SETTINGS" line4="    // ============================================================" line5="" line6="    export enum PortalButton {" line7="        A = 0," line8="        B = 1," line9="        Left = 2," line10="        Right = 3," line11="        Up = 4," line12="        Down = 5" line13="    }" line14="" line15="    let player: Sprite = null" line16="" line17="    let bluePortal: Sprite = null" line18="    let orangePortal: Sprite = null" line19="" line20="    let portalSurfaceTile: Image = null" line21="" line22="    let bluePortalUp: Image = null" line23="    let bluePortalDown: Image = null" line24="    let bluePortalLeft: Image = null" line25="    let bluePortalRight: Image = null" line26="" line27="    let orangePortalUp: Image = null" line28="    let orangePortalDown: Image = null" line29="    let orangePortalLeft: Image = null" line30="    let orangePortalRight: Image = null" line31="" line32="    let blueProjectileImage: Image = null" line33="    let orangeProjectileImage: Image = null" line34="" line35="    let blueButton = PortalButton.A" line36="    let orangeButton = PortalButton.B" line37="" line38="    let portalSpeed = 150" line39="    let teleportTime = 300" line40="    let teleportCooldown = 350" line41="" line42="    let blueNormalX = 0" line43="    let blueNormalY = -1" line44="" line45="    let orangeNormalX = 0" line46="    let orangeNormalY = -1" line47="" line48="    let teleporting = false" line49="    let lastTeleportTime = 0" line50="" line51="    const blueProjectileKind = SpriteKind.create()" line52="    const orangeProjectileKind = SpriteKind.create()" line53="    const portalKind = SpriteKind.create()" line54="" line55="" line56="    // ============================================================" line57="    // PLAYER" line58="    // ============================================================" line59="" line60="    //% block=&quot;set portal player $sprite&quot;" line61="    //% sprite.shadow=variables_get" line62="    export function setPortalPlayer(sprite: Sprite) {" line63="        player = sprite" line64="    }" line65="" line66="" line67="    // ============================================================" line68="    // PORTAL SURFACE" line69="    // ============================================================" line70="" line71="    //% block=&quot;set portal surface tile $tile&quot;" line72="    //% tile.shadow=tileset_tile_picker" line73="    export function setPortalSurfaceTile(tile: Image) {" line74="        portalSurfaceTile = tile" line75="    }" line76="" line77="" line78="    // ============================================================" line79="    // BLUE PORTAL ART" line80="    // ============================================================" line81="" line82="    //% block=&quot;set blue portal up image $image&quot;" line83="    //% imageLiteral=1" line84="    export function setBluePortalUpImage(image: Image) {" line85="        bluePortalUp = image" line86="    }" line87="" line88="    //% block=&quot;set blue portal down image $image&quot;" line89="    //% imageLiteral=1" line90="    export function setBluePortalDownImage(image: Image) {" line91="        bluePortalDown = image" line92="    }" line93="" line94="    //% block=&quot;set blue portal left image $image&quot;" line95="    //% imageLiteral=1" line96="    export function setBluePortalLeftImage(image: Image) {" line97="        bluePortalLeft = image" line98="    }" line99="" line100="    //% block=&quot;set blue portal right image $image&quot;" line101="    //% imageLiteral=1" line102="    export function setBluePortalRightImage(image: Image) {" line103="        bluePortalRight = image" line104="    }" line105="" line106="" line107="    // ============================================================" line108="    // ORANGE PORTAL ART" line109="    // ============================================================" line110="" line111="    //% block=&quot;set orange portal up image $image&quot;" line112="    //% imageLiteral=1" line113="    export function setOrangePortalUpImage(image: Image) {" line114="        orangePortalUp = image" line115="    }" line116="" line117="    //% block=&quot;set orange portal down image $image&quot;" line118="    //% imageLiteral=1" line119="    export function setOrangePortalDownImage(image: Image) {" line120="        orangePortalDown = image" line121="    }" line122="" line123="    //% block=&quot;set orange portal left image $image&quot;" line124="    //% imageLiteral=1" line125="    export function setOrangePortalLeftImage(image: Image) {" line126="        orangePortalLeft = image" line127="    }" line128="" line129="    //% block=&quot;set orange portal right image $image&quot;" line130="    //% imageLiteral=1" line131="    export function setOrangePortalRightImage(image: Image) {" line132="        orangePortalRight = image" line133="    }" line134="" line135="" line136="    // ============================================================" line137="    // PROJECTILE ART" line138="    // ============================================================" line139="" line140="    //% block=&quot;set blue portal projectile image $image&quot;" line141="    //% imageLiteral=1" line142="    export function setBlueProjectileImage(image: Image) {" line143="        blueProjectileImage = image" line144="    }" line145="" line146="    //% block=&quot;set orange portal projectile image $image&quot;" line147="    //% imageLiteral=1" line148="    export function setOrangeProjectileImage(image: Image) {" line149="        orangeProjectileImage = image" line150="    }" line151="" line152="" line153="    // ============================================================" line154="    // BUTTON SETTINGS" line155="    // ============================================================" line156="" line157="    //% block=&quot;blue portal button $button&quot;" line158="    export function setBluePortalButton(button: PortalButton) {" line159="        blueButton = button" line160="    }" line161="" line162="    //% block=&quot;orange portal button $button&quot;" line163="    export function setOrangePortalButton(button: PortalButton) {" line164="        orangeButton = button" line165="    }" line166="" line167="" line168="    // ============================================================" line169="    // PHYSICS SETTINGS" line170="    // ============================================================" line171="" line172="    //% block=&quot;portal projectile speed $speed&quot;" line173="    //% speed.min=20 speed.max=300" line174="    export function setPortalProjectileSpeed(speed: number) {" line175="        portalSpeed = speed" line176="    }" line177="" line178="    //% block=&quot;portal teleport time $time ms&quot;" line179="    //% time.min=50 time.max=1000" line180="    export function setPortalTeleportTime(time: number) {" line181="        teleportTime = time" line182="    }" line183="" line184="    //% block=&quot;portal teleport cooldown $time ms&quot;" line185="    //% time.min=0 time.max=2000" line186="    export function setPortalTeleportCooldown(time: number) {" line187="        teleportCooldown = time" line188="    }" line189="" line190="" line191="    // ============================================================" line192="    // IMAGE HELPERS" line193="    // ============================================================" line194="" line195="    function getBluePortalImage(): Image {" line196="        if (blueNormalX &lt; 0) {" line197="            if (bluePortalLeft != null) {" line198="                return bluePortalLeft" line199="            }" line200="        }" line201="" line202="        if (blueNormalX &gt; 0) {" line203="            if (bluePortalRight != null) {" line204="                return bluePortalRight" line205="            }" line206="        }" line207="" line208="        if (blueNormalY &lt; 0) {" line209="            if (bluePortalUp != null) {" line210="                return bluePortalUp" line211="            }" line212="        }" line213="" line214="        if (blueNormalY &gt; 0) {" line215="            if (bluePortalDown != null) {" line216="                return bluePortalDown" line217="            }" line218="        }" line219="" line220="        return image.create(1, 1)" line221="    }" line222="" line223="" line224="    function getOrangePortalImage(): Image {" line225="        if (orangeNormalX &lt; 0) {" line226="            if (orangePortalLeft != null) {" line227="                return orangePortalLeft" line228="            }" line229="        }" line230="" line231="        if (orangeNormalX &gt; 0) {" line232="            if (orangePortalRight != null) {" line233="                return orangePortalRight" line234="            }" line235="        }" line236="" line237="        if (orangeNormalY &lt; 0) {" line238="            if (orangePortalUp != null) {" line239="                return orangePortalUp" line240="            }" line241="        }" line242="" line243="        if (orangeNormalY &gt; 0) {" line244="            if (orangePortalDown != null) {" line245="                return orangePortalDown" line246="            }" line247="        }" line248="" line249="        return image.create(1, 1)" line250="    }" line251="" line252="" line253="    // ============================================================" line254="    // PROJECTILE CREATION" line255="    // ============================================================" line256="" line257="    function createPortalProjectile(isBlue: boolean) {" line258="        if (player == null) {" line259="            return" line260="        }" line261="" line262="        let imageToUse: Image" line263="" line264="        if (isBlue) {" line265="            imageToUse = blueProjectileImage" line266="        } else {" line267="            imageToUse = orangeProjectileImage" line268="        }" line269="" line270="        if (imageToUse == null) {" line271="            imageToUse = image.create(3, 3)" line272="        }" line273="" line274="        let dx = controller.dx()" line275="        let dy = controller.dy()" line276="" line277="        // If the controller isn't currently pointing," line278="        // use the player's velocity." line279="        if (dx == 0 &amp;&amp; dy == 0) {" line280="            dx = player.vx" line281="            dy = player.vy" line282="        }" line283="" line284="        // Default direction: up" line285="        if (dx == 0 &amp;&amp; dy == 0) {" line286="            dy = -1" line287="        }" line288="" line289="        let projectile = sprites.createProjectileFromSprite(" line290="            imageToUse," line291="            player," line292="            dx," line293="            dy" line294="        )" line295="" line296="        if (isBlue) {" line297="            projectile.setKind(blueProjectileKind)" line298="        } else {" line299="            projectile.setKind(orangeProjectileKind)" line300="        }" line301="" line302="        projectile.setFlag(SpriteFlag.GhostThroughWalls, true)" line303="        projectile.lifespan = 5000" line304="" line305="        // Normalize the velocity so speed is consistent" line306="        let length = Math.sqrt(" line307="            projectile.vx * projectile.vx +" line308="            projectile.vy * projectile.vy" line309="        )" line310="" line311="        if (length &gt; 0) {" line312="            projectile.vx = projectile.vx / length * portalSpeed" line313="            projectile.vy = projectile.vy / length * portalSpeed" line314="        }" line315="    }" line316="" line317="" line318="    // ============================================================" line319="    // MANUAL SHOOT BLOCKS" line320="    // ============================================================" line321="" line322="    //% block=&quot;shoot blue portal&quot;" line323="    export function shootBluePortal() {" line324="        createPortalProjectile(true)" line325="    }" line326="" line327="    //% block=&quot;shoot orange portal&quot;" line328="    export function shootOrangePortal() {" line329="        createPortalProjectile(false)" line330="    }" line331="" line332="" line333="    // ============================================================" line334="    // PORTAL PLACEMENT" line335="    // ============================================================" line336="" line337="    function placeBluePortal(col: number, row: number, nx: number, ny: number) {" line338="        if (bluePortal != null) {" line339="            bluePortal.destroy()" line340="        }" line341="" line342="        blueNormalX = nx" line343="        blueNormalY = ny" line344="" line345="        bluePortal = sprites.create(" line346="            getBluePortalImage()," line347="            portalKind" line348="        )" line349="" line350="        bluePortal.x = col * 16 + 8" line351="        bluePortal.y = row * 16 + 8" line352="" line353="        bluePortal.setFlag(SpriteFlag.Ghost, true)" line354="        bluePortal.setFlag(SpriteFlag.GhostThroughWalls, true)" line355="    }" line356="" line357="" line358="    function placeOrangePortal(col: number, row: number, nx: number, ny: number) {" line359="        if (orangePortal != null) {" line360="            orangePortal.destroy()" line361="        }" line362="" line363="        orangeNormalX = nx" line364="        orangeNormalY = ny" line365="" line366="        orangePortal = sprites.create(" line367="            getOrangePortalImage()," line368="            portalKind" line369="        )" line370="" line371="        orangePortal.x = col * 16 + 8" line372="        orangePortal.y = row * 16 + 8" line373="" line374="        orangePortal.setFlag(SpriteFlag.Ghost, true)" line375="        orangePortal.setFlag(SpriteFlag.GhostThroughWalls, true)" line376="    }" line377="" line378="" line379="    // ============================================================" line380="    // FIND PORTAL SURFACE" line381="    // ============================================================" line382="" line383="    function checkProjectile(projectile: Sprite, isBlue: boolean) {" line384="        if (portalSurfaceTile == null) {" line385="            return" line386="        }" line387="" line388="        let location = projectile.tilemapLocation()" line389="" line390="        if (!tiles.tileAtLocationEquals(location, portalSurfaceTile)) {" line391="            return" line392="        }" line393="" line394="        let nx = 0" line395="        let ny = 0" line396="" line397="        // Determine which direction the projectile hit from." line398="        if (Math.abs(projectile.vx) &gt; Math.abs(projectile.vy)) {" line399="            if (projectile.vx &gt; 0) {" line400="                nx = -1" line401="            } else {" line402="                nx = 1" line403="            }" line404="        } else {" line405="            if (projectile.vy &gt; 0) {" line406="                ny = -1" line407="            } else {" line408="                ny = 1" line409="            }" line410="        }" line411="" line412="        if (isBlue) {" line413="            placeBluePortal(" line414="                location.column," line415="                location.row," line416="                nx," line417="                ny" line418="            )" line419="        } else {" line420="            placeOrangePortal(" line421="                location.column," line422="                location.row," line423="                nx," line424="                ny" line425="            )" line426="        }" line427="" line428="        projectile.destroy()" line429="    }" line430="" line431="" line432="    // ============================================================" line433="    // TELEPORTING" line434="    // ============================================================" line435="" line436="    function tryTeleport() {" line437="        if (player == null) {" line438="            return" line439="        }" line440="" line441="        if (bluePortal == null || orangePortal == null) {" line442="            return" line443="        }" line444="" line445="        if (teleporting) {" line446="            return" line447="        }" line448="" line449="        if (game.runtime() - lastTeleportTime &lt; teleportCooldown) {" line450="            return" line451="        }" line452="" line453="        let distanceBlue = Math.sqrt(" line454="            Math.pow(player.x - bluePortal.x, 2) +" line455="            Math.pow(player.y - bluePortal.y, 2)" line456="        )" line457="" line458="        let distanceOrange = Math.sqrt(" line459="            Math.pow(player.x - orangePortal.x, 2) +" line460="            Math.pow(player.y - orangePortal.y, 2)" line461="        )" line462="" line463="        if (distanceBlue &lt; 12) {" line464="            if (movingIntoPortal(" line465="                player," line466="                blueNormalX," line467="                blueNormalY" line468="            )) {" line469="                teleportPlayer(" line470="                    bluePortal," line471="                    orangePortal," line472="                    blueNormalX," line473="                    blueNormalY," line474="                    orangeNormalX," line475="                    orangeNormalY" line476="                )" line477="            }" line478="        } else if (distanceOrange &lt; 12) {" line479="            if (movingIntoPortal(" line480="                player," line481="                orangeNormalX," line482="                orangeNormalY" line483="            )) {" line484="                teleportPlayer(" line485="                    orangePortal," line486="                    bluePortal," line487="                    orangeNormalX," line488="                    orangeNormalY," line489="                    blueNormalX," line490="                    blueNormalY" line491="                )" line492="            }" line493="        }" line494="    }" line495="" line496="" line497="    function movingIntoPortal(" line498="        sprite: Sprite," line499="        nx: number," line500="        ny: number" line501="    ): boolean {" line502="        let movement = sprite.vx * nx + sprite.vy * ny" line503="" line504="        return movement &gt; 0" line505="    }" line506="" line507="" line508="    function teleportPlayer(" line509="        entrance: Sprite," line510="        exit: Sprite," line511="        entranceNX: number," line512="        entranceNY: number," line513="        exitNX: number," line514="        exitNY: number" line515="    ) {" line516="        teleporting = true" line517="        lastTeleportTime = game.runtime()" line518="" line519="        let oldVX = player.vx" line520="        let oldVY = player.vy" line521="" line522="        let oldX = player.x" line523="        let oldY = player.y" line524="" line525="        // Small offset so the player doesn't get stuck" line526="        let entranceX = entrance.x + entranceNX * 8" line527="        let entranceY = entrance.y + entranceNY * 8" line528="" line529="        let exitX = exit.x + exitNX * 12" line530="        let exitY = exit.y + exitNY * 12" line531="" line532="        player.setFlag(SpriteFlag.Ghost, true)" line533="" line534="        let startTime = game.runtime()" line535="" line536="        game.onUpdate(function () {" line537="            if (!teleporting) {" line538="                return" line539="            }" line540="" line541="            let elapsed = game.runtime() - startTime" line542="            let progress = elapsed / teleportTime" line543="" line544="            if (progress &gt;= 1) {" line545="                player.x = exitX" line546="                player.y = exitY" line547="" line548="                player.setScale(100, ScaleAnchor.Middle)" line549="" line550="                player.vx = oldVX" line551="                player.vy = oldVY" line552="" line553="                player.setFlag(SpriteFlag.Ghost, false)" line554="" line555="                teleporting = false" line556="                return" line557="            }" line558="" line559="            if (progress &lt; 0.5) {" line560="                // Entering portal" line561="                let p = progress * 2" line562="" line563="                player.x = oldX +" line564="                    (entranceX - oldX) * p" line565="" line566="                player.y = oldY +" line567="                    (entranceY - oldY) * p" line568="" line569="                let scale = 100 - p * 75" line570="                player.setScale(" line571="                    scale," line572="                    ScaleAnchor.Middle" line573="                )" line574="            } else {" line575="                // Coming out of portal" line576="                let q = (progress - 0.5) * 2" line577="" line578="                player.x = entranceX +" line579="                    (exitX - entranceX) * q" line580="" line581="                player.y = entranceY +" line582="                    (exitY - entranceY) * q" line583="" line584="                let scale2 = 25 + q * 75" line585="" line586="                player.setScale(" line587="                    scale2," line588="                    ScaleAnchor.Middle" line589="                )" line590="            }" line591="        })" line592="    }" line593="" line594="" line595="    // ============================================================" line596="    // REMOVE PORTALS" line597="    // ============================================================" line598="" line599="    //% block=&quot;remove blue portal&quot;" line600="    export function removeBluePortal() {" line601="        if (bluePortal != null) {" line602="            bluePortal.destroy()" line603="            bluePortal = null" line604="        }" line605="    }" line606="" line607="    //% block=&quot;remove orange portal&quot;" line608="    export function removeOrangePortal() {" line609="        if (orangePortal != null) {" line610="            orangePortal.destroy()" line611="            orangePortal = null" line612="        }" line613="    }" line614="" line615="    //% block=&quot;remove all portals&quot;" line616="    export function removeAllPortals() {" line617="        removeBluePortal()" line618="        removeOrangePortal()" line619="    }" line620="" line621="" line622="    // ============================================================" line623="    // GAME LOOP" line624="    // ============================================================" line625="" line626="    game.onUpdate(function () {" line627="" line628="        for (let projectile2 of sprites.allOfKind(blueProjectileKind)) {" line629="            checkProjectile(projectile2, true)" line630="        }" line631="" line632="        for (let projectile3 of sprites.allOfKind(orangeProjectileKind)) {" line633="            checkProjectile(projectile3, false)" line634="        }" line635="" line636="        tryTeleport()" line637="    })" line638="" line639="" line640="    // ============================================================" line641="    // CONTROLLER EVENTS" line642="    // ============================================================" line643="" line644="    controller.A.onEvent(ControllerButtonEvent.Pressed, function () {" line645="        if (blueButton == PortalButton.A) {" line646="            shootBluePortal()" line647="        }" line648="" line649="        if (orangeButton == PortalButton.A) {" line650="            shootOrangePortal()" line651="        }" line652="    })" line653="" line654="" line655="    controller.B.onEvent(ControllerButtonEvent.Pressed, function () {" line656="        if (blueButton == PortalButton.B) {" line657="            shootBluePortal()" line658="        }" line659="" line660="        if (orangeButton == PortalButton.B) {" line661="            shootOrangePortal()" line662="        }" line663="    })" line664="" line665="" line666="    controller.left.onEvent(ControllerButtonEvent.Pressed, function () {" line667="        if (blueButton == PortalButton.Left) {" line668="            shootBluePortal()" line669="        }" line670="" line671="        if (orangeButton == PortalButton.Left) {" line672="            shootOrangePortal()" line673="        }" line674="    })" line675="" line676="" line677="    controller.right.onEvent(ControllerButtonEvent.Pressed, function () {" line678="        if (blueButton == PortalButton.Right) {" line679="            shootBluePortal()" line680="        }" line681="" line682="        if (orangeButton == PortalButton.Right) {" line683="            shootOrangePortal()" line684="        }" line685="    })" line686="" line687="" line688="    controller.up.onEvent(ControllerButtonEvent.Pressed, function () {" line689="        if (blueButton == PortalButton.Up) {" line690="            shootBluePortal()" line691="        }" line692="" line693="        if (orangeButton == PortalButton.Up) {" line694="            shootOrangePortal()" line695="        }" line696="    })" line697="" line698="" line699="    controller.down.onEvent(ControllerButtonEvent.Pressed, function () {" line700="        if (blueButton == PortalButton.Down) {" line701="            shootBluePortal()" line702="        }" line703="" line704="        if (orangeButton == PortalButton.Down) {" line705="            shootOrangePortal()" line706="        }" line707="    })" line708="}" numlines="709"></mutation></block></statement></block><block type="variables_set" id="84Yd_wDrsV~VI$(_=1Oc" disabled-reasons="pxt_automatic_disabled" x="818" y="20"><field name="VAR" id="tMl{#3I%AHw}TQ_=`n%@">mySprite</field><value name="VALUE"><shadow type="math_number" id="!m^IOBv3-X7,BV|Nr]rS"><field name="NUM">0</field></shadow><block type="spritescreate" id="R/b[3dY3Z=,#R4!D7Dn4" disabled-reasons="pxt_automatic_disabled"><value name="img"><shadow type="screen_image_picker" id="QG$J}}@(Kd)*gL}^yW_4" disabled-reasons="pxt_automatic_disabled"><field name="img">img`
