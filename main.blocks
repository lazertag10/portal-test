<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id=";?K|r*sc!*!}yiCsf1,v" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="(HP`F`);}_4+y-;mcp~f"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace smoothPortals {" line1="" line2="    // =========================================================" line3="    // BUTTON ENUM" line4="    // =========================================================" line5="" line6="    export enum PortalButton {" line7="        //% block=&quot;A&quot;" line8="        A = 0," line9="" line10="        //% block=&quot;B&quot;" line11="        B = 1," line12="" line13="        //% block=&quot;left&quot;" line14="        Left = 2," line15="" line16="        //% block=&quot;right&quot;" line17="        Right = 3," line18="" line19="        //% block=&quot;up&quot;" line20="        Up = 4," line21="" line22="        //% block=&quot;down&quot;" line23="        Down = 5" line24="    }" line25="" line26="    // =========================================================" line27="    // SPRITE KINDS" line28="    // =========================================================" line29="" line30="    const blueBulletKind = SpriteKind.create()" line31="    const orangeBulletKind = SpriteKind.create()" line32="" line33="    // =========================================================" line34="    // VARIABLES" line35="    // =========================================================" line36="" line37="    let playerSprite: Sprite = null" line38="" line39="    let bluePortalSprite: Sprite = null" line40="    let orangePortalSprite: Sprite = null" line41="" line42="    let blueNX = 0" line43="    let blueNY = -1" line44="" line45="    let orangeNX = 0" line46="    let orangeNY = -1" line47="" line48="    let selectedBlueButton = PortalButton.A" line49="    let selectedOrangeButton = PortalButton.B" line50="" line51="    let momentumOn = true" line52="    let physicsOn = true" line53="" line54="    let isTeleportingNow = false" line55="" line56="    let teleportClock = 0" line57="" line58="    let startX = 0" line59="    let startY = 0" line60="" line61="    let destinationX = 0" line62="    let destinationY = 0" line63="" line64="    let oldVX = 0" line65="    let oldVY = 0" line66="" line67="    let enterNX = 0" line68="    let enterNY = 0" line69="" line70="    let exitNX = 0" line71="    let exitNY = 0" line72="" line73="    let enterEvents: (() =&gt; void)[] = []" line74="    let exitEvents: (() =&gt; void)[] = []" line75="" line76="    const bulletSpeed = 140" line77="    const bulletLife = 3000" line78="" line79="    const teleportDuration = 300" line80="    const exitDistance = 20" line81="" line82="    // =========================================================" line83="    // PORTAL IMAGES" line84="    // =========================================================" line85="" line86="    const blueImage = img`" line87="        . . . . 8 8 8 8 . . . ." line88="        . . 8 9 9 9 9 9 9 8 . ." line89="        . 8 9 9 9 9 9 9 9 9 8 ." line90="        8 9 9 9 9 9 9 9 9 9 9 8" line91="        8 9 9 9 9 9 9 9 9 9 9 8" line92="        8 9 9 9 9 9 9 9 9 9 9 8" line93="        8 9 9 9 9 9 9 9 9 9 9 8" line94="        8 9 9 9 9 9 9 9 9 9 9 8" line95="        8 9 9 9 9 9 9 9 9 9 9 8" line96="        8 9 9 9 9 9 9 9 9 9 9 8" line97="        . 8 9 9 9 9 9 9 9 9 8 ." line98="        . . 8 9 9 9 9 9 9 8 . ." line99="    `" line100="" line101="    const orangeImage = img`" line102="        . . . . 5 5 5 5 . . . ." line103="        . . 5 4 4 4 4 4 4 5 . ." line104="        . 5 4 4 4 4 4 4 4 4 5 ." line105="        5 4 4 4 4 4 4 4 4 4 4 5" line106="        5 4 4 4 4 4 4 4 4 4 4 5" line107="        5 4 4 4 4 4 4 4 4 4 4 5" line108="        5 4 4 4 4 4 4 4 4 4 4 5" line109="        5 4 4 4 4 4 4 4 4 4 4 5" line110="        5 4 4 4 4 4 4 4 4 4 4 5" line111="        5 4 4 4 4 4 4 4 4 4 4 5" line112="        . 5 4 4 4 4 4 4 4 4 5 ." line113="        . . 5 4 4 4 4 4 4 5 . ." line114="    `" line115="" line116="    // =========================================================" line117="    // SET PLAYER" line118="    // =========================================================" line119="" line120="    //% block=&quot;set portal player to %sprite&quot;" line121="    //% blockId=smoothPortals_setPlayer" line122="    export function setPortalPlayer(sprite: Sprite): void {" line123="        playerSprite = sprite" line124="    }" line125="" line126="    // =========================================================" line127="    // BUTTON SETTINGS" line128="    // =========================================================" line129="" line130="    //% block=&quot;set blue portal button to %button&quot;" line131="    //% blockId=smoothPortals_blueButton" line132="    export function chooseBlueButton(" line133="        button: PortalButton" line134="    ): void {" line135="        selectedBlueButton = button" line136="    }" line137="" line138="    //% block=&quot;set orange portal button to %button&quot;" line139="    //% blockId=smoothPortals_orangeButton" line140="    export function chooseOrangeButton(" line141="        button: PortalButton" line142="    ): void {" line143="        selectedOrangeButton = button" line144="    }" line145="" line146="    // =========================================================" line147="    // MOMENTUM" line148="    // =========================================================" line149="" line150="    //% block=&quot;set portal momentum to %enabled&quot;" line151="    //% blockId=smoothPortals_setMomentum" line152="    export function enableMomentum(" line153="        enabled: boolean" line154="    ): void {" line155="        momentumOn = enabled" line156="    }" line157="" line158="    //% block=&quot;portal momentum is enabled&quot;" line159="    //% blockId=smoothPortals_momentum" line160="    export function getMomentum(): boolean {" line161="        return momentumOn" line162="    }" line163="" line164="    // =========================================================" line165="    // PHYSICS" line166="    // =========================================================" line167="" line168="    //% block=&quot;set portal physics to %enabled&quot;" line169="    //% blockId=smoothPortals_setPhysics" line170="    export function enablePhysics(" line171="        enabled: boolean" line172="    ): void {" line173="        physicsOn = enabled" line174="    }" line175="" line176="    // =========================================================" line177="    // FIRE BLUE" line178="    // =========================================================" line179="" line180="    //% block=&quot;shoot blue portal&quot;" line181="    //% blockId=smoothPortals_shootBlue" line182="    export function shootBluePortal(): void {" line183="" line184="        if (!physicsOn)" line185="            return" line186="" line187="        if (!playerSprite)" line188="            return" line189="" line190="        shootPortal(true)" line191="    }" line192="" line193="    // =========================================================" line194="    // FIRE ORANGE" line195="    // =========================================================" line196="" line197="    //% block=&quot;shoot orange portal&quot;" line198="    //% blockId=smoothPortals_shootOrange" line199="    export function shootOrangePortal(): void {" line200="" line201="        if (!physicsOn)" line202="            return" line203="" line204="        if (!playerSprite)" line205="            return" line206="" line207="        shootPortal(false)" line208="    }" line209="" line210="    // =========================================================" line211="    // SHOOT PORTAL" line212="    // =========================================================" line213="" line214="    function shootPortal(isBlue: boolean): void {" line215="" line216="        let dx = controller.dx()" line217="        let dy = controller.dy()" line218="" line219="        if (dx == 0 &amp;&amp; dy == 0) {" line220="" line221="            dx = playerSprite.vx" line222="            dy = playerSprite.vy" line223="" line224="            if (dx == 0 &amp;&amp; dy == 0) {" line225="                dy = -1" line226="            }" line227="        }" line228="" line229="        let length =" line230="            Math.sqrt(dx * dx + dy * dy)" line231="" line232="        if (length == 0)" line233="            return" line234="" line235="        dx /= length" line236="        dy /= length" line237="" line238="        dx *= bulletSpeed" line239="        dy *= bulletSpeed" line240="" line241="        let bullet: Sprite" line242="" line243="        if (isBlue) {" line244="" line245="            bullet = sprites.createProjectileFromSprite(" line246="                blueImage," line247="                playerSprite," line248="                dx," line249="                dy" line250="            )" line251="" line252="            bullet.setKind(blueBulletKind)" line253="" line254="        } else {" line255="" line256="            bullet = sprites.createProjectileFromSprite(" line257="                orangeImage," line258="                playerSprite," line259="                dx," line260="                dy" line261="            )" line262="" line263="            bullet.setKind(orangeBulletKind)" line264="        }" line265="" line266="        bullet.lifespan = bulletLife" line267="    }" line268="" line269="    // =========================================================" line270="    // BLUE BULLET" line271="    // =========================================================" line272="" line273="    game.onUpdate(function () {" line274="" line275="        let bullets =" line276="            sprites.allOfKind(blueBulletKind)" line277="" line278="        for (let bullet2 of bullets) {" line279="" line280="            checkBullet(bullet2, true)" line281="        }" line282="    })" line283="" line284="    // =========================================================" line285="    // ORANGE BULLET" line286="    // =========================================================" line287="" line288="    game.onUpdate(function () {" line289="" line290="        let bullets2 =" line291="            sprites.allOfKind(orangeBulletKind)" line292="" line293="        for (let bullet3 of bullets2) {" line294="" line295="            checkBullet(bullet3, false)" line296="        }" line297="    })" line298="" line299="    // =========================================================" line300="    // BULLET COLLISION" line301="    // =========================================================" line302="" line303="    function checkBullet(" line304="        bullet: Sprite," line305="        isBlue: boolean" line306="    ): void {" line307="" line308="        if (!bullet)" line309="            return" line310="" line311="        let column =" line312="            Math.floor(bullet.x / 16)" line313="" line314="        let row =" line315="            Math.floor(bullet.y / 16)" line316="" line317="        if (column &lt; 0 || row &lt; 0)" line318="            return" line319="" line320="        let tile =" line321="            tiles.getTileLocation(" line322="                column," line323="                row" line324="            )" line325="" line326="        if (!tiles.tileAtLocationIsWall(tile))" line327="            return" line328="" line329="        let nx = 0" line330="        let ny = 0" line331="" line332="        if (Math.abs(bullet.vx) &gt;" line333="            Math.abs(bullet.vy)) {" line334="" line335="            if (bullet.vx &gt; 0)" line336="                nx = -1" line337="            else" line338="                nx = 1" line339="" line340="        } else {" line341="" line342="            if (bullet.vy &gt; 0)" line343="                ny = -1" line344="            else" line345="                ny = 1" line346="        }" line347="" line348="        createPortal(" line349="            isBlue," line350="            column * 16 + 8," line351="            row * 16 + 8," line352="            nx," line353="            ny" line354="        )" line355="" line356="        bullet.destroy()" line357="    }" line358="" line359="    // =========================================================" line360="    // CREATE PORTAL" line361="    // =========================================================" line362="" line363="    function createPortal(" line364="        isBlue: boolean," line365="        x: number," line366="        y: number," line367="        nx: number," line368="        ny: number" line369="    ): void {" line370="" line371="        if (isBlue) {" line372="" line373="            if (bluePortalSprite)" line374="                bluePortalSprite.destroy()" line375="" line376="            bluePortalSprite =" line377="                sprites.create(" line378="                    blueImage," line379="                    SpriteKind.Food" line380="                )" line381="" line382="            bluePortalSprite.setFlag(" line383="                SpriteFlag.Ghost," line384="                true" line385="            )" line386="" line387="            bluePortalSprite.setPosition(" line388="                x," line389="                y" line390="            )" line391="" line392="            blueNX = nx" line393="            blueNY = ny" line394="" line395="        } else {" line396="" line397="            if (orangePortalSprite)" line398="                orangePortalSprite.destroy()" line399="" line400="            orangePortalSprite =" line401="                sprites.create(" line402="                    orangeImage," line403="                    SpriteKind.Food" line404="                )" line405="" line406="            orangePortalSprite.setFlag(" line407="                SpriteFlag.Ghost," line408="                true" line409="            )" line410="" line411="            orangePortalSprite.setPosition(" line412="                x," line413="                y" line414="            )" line415="" line416="            orangeNX = nx" line417="            orangeNY = ny" line418="        }" line419="    }" line420="" line421="    // =========================================================" line422="    // TELEPORT CHECK" line423="    // =========================================================" line424="" line425="    game.onUpdate(function () {" line426="" line427="        if (!physicsOn)" line428="            return" line429="" line430="        if (!playerSprite)" line431="            return" line432="" line433="        if (!bluePortalSprite ||" line434="            !orangePortalSprite)" line435="            return" line436="" line437="        if (isTeleportingNow)" line438="            return" line439="" line440="        if (playerSprite.overlapsWith(" line441="            bluePortalSprite" line442="        )) {" line443="" line444="            beginPortalTeleport(" line445="                bluePortalSprite," line446="                orangePortalSprite," line447="                blueNX," line448="                blueNY," line449="                orangeNX," line450="                orangeNY" line451="            )" line452="" line453="            return" line454="        }" line455="" line456="        if (playerSprite.overlapsWith(" line457="            orangePortalSprite" line458="        )) {" line459="" line460="            beginPortalTeleport(" line461="                orangePortalSprite," line462="                bluePortalSprite," line463="                orangeNX," line464="                orangeNY," line465="                blueNX," line466="                blueNY" line467="            )" line468="        }" line469="    })" line470="" line471="    // =========================================================" line472="    // BEGIN TELEPORT" line473="    // =========================================================" line474="" line475="    function beginPortalTeleport(" line476="        entrance: Sprite," line477="        exit: Sprite," line478="        entranceNX: number," line479="        entranceNY: number," line480="        exitNX: number," line481="        exitNY: number" line482="    ): void {" line483="" line484="        if (isTeleportingNow)" line485="            return" line486="" line487="        isTeleportingNow = true" line488="        teleportClock = 0" line489="" line490="        startX = playerSprite.x" line491="        startY = playerSprite.y" line492="" line493="        oldVX = playerSprite.vx" line494="        oldVY = playerSprite.vy" line495="" line496="        enterNX = entranceNX" line497="        enterNY = entranceNY" line498="" line499="        exitNX = exitNX" line500="        exitNY = exitNY" line501="" line502="        destinationX =" line503="            exit.x +" line504="            exitNX * exitDistance" line505="" line506="        destinationY =" line507="            exit.y +" line508="            exitNY * exitDistance" line509="" line510="        for (let event of enterEvents) {" line511="            event()" line512="        }" line513="    }" line514="" line515="    // =========================================================" line516="    // SMOOTH TELEPORT" line517="    // =========================================================" line518="" line519="    game.onUpdateInterval(" line520="        10," line521="        function () {" line522="" line523="            if (!isTeleportingNow)" line524="                return" line525="" line526="            if (!playerSprite)" line527="                return" line528="" line529="            teleportClock += 10" line530="" line531="            let amount =" line532="                teleportClock /" line533="                teleportDuration" line534="" line535="            if (amount &gt; 1)" line536="                amount = 1" line537="" line538="            // Smoothstep interpolation." line539="            let smooth =" line540="                amount *" line541="                amount *" line542="                (3 - 2 * amount)" line543="" line544="            playerSprite.x =" line545="                startX +" line546="                (destinationX - startX) *" line547="                smooth" line548="" line549="            playerSprite.y =" line550="                startY +" line551="                (destinationY - startY) *" line552="                smooth" line553="" line554="            if (momentumOn) {" line555="" line556="                playerSprite.vx = oldVX" line557="                playerSprite.vy = oldVY" line558="            }" line559="" line560="            if (amount &gt;= 1) {" line561="" line562="                finishPortalTeleport()" line563="            }" line564="        }" line565="    )" line566="" line567="    // =========================================================" line568="    // FINISH TELEPORT" line569="    // =========================================================" line570="" line571="    function finishPortalTeleport(): void {" line572="" line573="        if (!playerSprite)" line574="            return" line575="" line576="        if (momentumOn) {" line577="" line578="            applyMomentum(" line579="                oldVX," line580="                oldVY," line581="                enterNX," line582="                enterNY," line583="                exitNX," line584="                exitNY" line585="            )" line586="" line587="        } else {" line588="" line589="            playerSprite.vx = 0" line590="            playerSprite.vy = 0" line591="        }" line592="" line593="        isTeleportingNow = false" line594="" line595="        for (let event2 of exitEvents) {" line596="            event2()" line597="        }" line598="    }" line599="" line600="    // =========================================================" line601="    // MOMENTUM" line602="    // =========================================================" line603="" line604="    function applyMomentum(" line605="        vx: number," line606="        vy: number," line607="        inNX: number," line608="        inNY: number," line609="        outNX: number," line610="        outNY: number" line611="    ): void {" line612="" line613="        let inTX = -inNY" line614="        let inTY = inNX" line615="" line616="        let outTX = -outNY" line617="        let outTY = outNX" line618="" line619="        let tangent =" line620="            vx * inTX +" line621="            vy * inTY" line622="" line623="        let normal =" line624="            vx * inNX +" line625="            vy * inNY" line626="" line627="        let outgoingNormal =" line628="            -normal" line629="" line630="        playerSprite.vx =" line631="            outTX * tangent +" line632="            outNX * outgoingNormal" line633="" line634="        playerSprite.vy =" line635="            outTY * tangent +" line636="            outNY * outgoingNormal" line637="    }" line638="" line639="    // =========================================================" line640="    // ENTER EVENT" line641="    // =========================================================" line642="" line643="    //% block=&quot;on player enter portal&quot;" line644="    //% blockId=smoothPortals_enter" line645="    export function whenPlayerEntersPortal(" line646="        handler: () =&gt; void" line647="    ): void {" line648="" line649="        enterEvents.push(handler)" line650="    }" line651="" line652="    // =========================================================" line653="    // EXIT EVENT" line654="    // =========================================================" line655="" line656="    //% block=&quot;on player exit portal&quot;" line657="    //% blockId=smoothPortals_exit" line658="    export function whenPlayerExitsPortal(" line659="        handler: () =&gt; void" line660="    ): void {" line661="" line662="        exitEvents.push(handler)" line663="    }" line664="" line665="    // =========================================================" line666="    // STATUS" line667="    // =========================================================" line668="" line669="    //% block=&quot;blue portal exists&quot;" line670="    //% blockId=smoothPortals_blueExists" line671="    export function hasBluePortal(): boolean {" line672="" line673="        return bluePortalSprite != null" line674="    }" line675="" line676="    //% block=&quot;orange portal exists&quot;" line677="    //% blockId=smoothPortals_orangeExists" line678="    export function hasOrangePortal(): boolean {" line679="" line680="        return orangePortalSprite != null" line681="    }" line682="" line683="    //% block=&quot;both portals exist&quot;" line684="    //% blockId=smoothPortals_bothExist" line685="    export function hasBothPortals(): boolean {" line686="" line687="        return bluePortalSprite != null &amp;&amp;" line688="            orangePortalSprite != null" line689="    }" line690="" line691="    //% block=&quot;player is going through portal&quot;" line692="    //% blockId=smoothPortals_teleporting" line693="    export function playerIsTeleporting(): boolean {" line694="" line695="        return isTeleportingNow" line696="    }" line697="" line698="    // =========================================================" line699="    // REMOVE BLUE" line700="    // =========================================================" line701="" line702="    //% block=&quot;remove blue portal&quot;" line703="    //% blockId=smoothPortals_removeBlue" line704="    export function deleteBluePortal(): void {" line705="" line706="        if (bluePortalSprite) {" line707="" line708="            bluePortalSprite.destroy()" line709="            bluePortalSprite = null" line710="        }" line711="    }" line712="" line713="    // =========================================================" line714="    // REMOVE ORANGE" line715="    // =========================================================" line716="" line717="    //% block=&quot;remove orange portal&quot;" line718="    //% blockId=smoothPortals_removeOrange" line719="    export function deleteOrangePortal(): void {" line720="" line721="        if (orangePortalSprite) {" line722="" line723="            orangePortalSprite.destroy()" line724="            orangePortalSprite = null" line725="        }" line726="    }" line727="" line728="    // =========================================================" line729="    // REMOVE BOTH" line730="    // =========================================================" line731="" line732="    //% block=&quot;remove both portals&quot;" line733="    //% blockId=smoothPortals_removeBoth" line734="    export function deleteBothPortals(): void {" line735="" line736="        deleteBluePortal()" line737="        deleteOrangePortal()" line738="    }" line739="" line740="    // =========================================================" line741="    // BUTTON A" line742="    // =========================================================" line743="" line744="    controller.A.onEvent(" line745="        ControllerButtonEvent.Pressed," line746="        function () {" line747="" line748="            if (selectedBlueButton ==" line749="                PortalButton.A) {" line750="" line751="                shootBluePortal()" line752="            }" line753="" line754="            if (selectedOrangeButton ==" line755="                PortalButton.A) {" line756="" line757="                shootOrangePortal()" line758="            }" line759="        }" line760="    )" line761="" line762="    // =========================================================" line763="    // BUTTON B" line764="    // =========================================================" line765="" line766="    controller.B.onEvent(" line767="        ControllerButtonEvent.Pressed," line768="        function () {" line769="" line770="            if (selectedBlueButton ==" line771="                PortalButton.B) {" line772="" line773="                shootBluePortal()" line774="            }" line775="" line776="            if (selectedOrangeButton ==" line777="                PortalButton.B) {" line778="" line779="                shootOrangePortal()" line780="            }" line781="        }" line782="    )" line783="" line784="    // =========================================================" line785="    // LEFT" line786="    // =========================================================" line787="" line788="    controller.left.onEvent(" line789="        ControllerButtonEvent.Pressed," line790="        function () {" line791="" line792="            if (selectedBlueButton ==" line793="                PortalButton.Left) {" line794="" line795="                shootBluePortal()" line796="            }" line797="" line798="            if (selectedOrangeButton ==" line799="                PortalButton.Left) {" line800="" line801="                shootOrangePortal()" line802="            }" line803="        }" line804="    )" line805="" line806="    // =========================================================" line807="    // RIGHT" line808="    // =========================================================" line809="" line810="    controller.right.onEvent(" line811="        ControllerButtonEvent.Pressed," line812="        function () {" line813="" line814="            if (selectedBlueButton ==" line815="                PortalButton.Right) {" line816="" line817="                shootBluePortal()" line818="            }" line819="" line820="            if (selectedOrangeButton ==" line821="                PortalButton.Right) {" line822="" line823="                shootOrangePortal()" line824="            }" line825="        }" line826="    )" line827="" line828="    // =========================================================" line829="    // UP" line830="    // =========================================================" line831="" line832="    controller.up.onEvent(" line833="        ControllerButtonEvent.Pressed," line834="        function () {" line835="" line836="            if (selectedBlueButton ==" line837="                PortalButton.Up) {" line838="" line839="                shootBluePortal()" line840="            }" line841="" line842="            if (selectedOrangeButton ==" line843="                PortalButton.Up) {" line844="" line845="                shootOrangePortal()" line846="            }" line847="        }" line848="    )" line849="" line850="    // =========================================================" line851="    // DOWN" line852="    // =========================================================" line853="" line854="    controller.down.onEvent(" line855="        ControllerButtonEvent.Pressed," line856="        function () {" line857="" line858="            if (selectedBlueButton ==" line859="                PortalButton.Down) {" line860="" line861="                shootBluePortal()" line862="            }" line863="" line864="            if (selectedOrangeButton ==" line865="                PortalButton.Down) {" line866="" line867="                shootOrangePortal()" line868="            }" line869="        }" line870="    )" line871="}" numlines="872"></mutation></block></statement></block></xml>